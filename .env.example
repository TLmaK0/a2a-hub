# a2a-hub — example configuration. Copy to `.env` and fill in.
# NEVER commit `.env` or real tokens (see .gitignore). In production, a k8s Secret.

# Agent tokens: token:agent pairs, comma-separated. One token = one agent.
# Generate tokens with, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
A2A_HUB_TOKENS=CHANGE_THIS_TOKEN_A:agent-one,CHANGE_THIS_TOKEN_B:agent-two

# Task store. SQLite file by default. For PostgreSQL use A2A_HUB_DB_URL.
A2A_HUB_DB_PATH=a2a-hub.db
# A2A_HUB_DB_URL=postgresql+asyncpg://user:pass@host:5432/a2a

# Public URL advertised in the Agent Card (/.well-known/agent-card.json).
A2A_HUB_PUBLIC_URL=https://a2a.example.com/

# Path of the A2A JSON-RPC endpoint (root by default).
# A2A_HUB_RPC_URL=/

# Server listen address.
A2A_HUB_HOST=0.0.0.0
A2A_HUB_PORT=8000

# Optional TLS: serve HTTPS directly (self-contained, no reverse proxy needed).
# Point these at a PEM cert/key pair. Leave unset to serve plain HTTP (e.g. when a
# reverse proxy terminates TLS).
# A2A_HUB_TLS_CERTFILE=/certs/tls.crt
# A2A_HUB_TLS_KEYFILE=/certs/tls.key
